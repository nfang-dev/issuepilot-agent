diff --git a/src/packaging/markers.py b/src/packaging/markers.py
--- a/src/packaging/markers.py
+++ b/src/packaging/markers.py
@@ -193,6 +193,13 @@
         except InvalidSpecifier:
             pass
         else:
+            # If the left-hand side is an empty string (which can occur for the
+            # "extra" environment when no extra is selected) avoid attempting
+            # to coerce it to a Version because Version('') raises
+            # InvalidVersion. In that situation the marker should simply be
+            # False.
+            if lhs == "":
+                return False
             return spec.contains(lhs, prereleases=True)
 
     oper: Operator | None = _operators.get(op.serialize())
