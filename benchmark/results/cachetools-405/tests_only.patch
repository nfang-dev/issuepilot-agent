+    def test_lru_update_grow_getsizeof(self):
+        # Regression test: growing an existing key should not over-evict
+        cache = LRUCache[int, int](maxsize=10, getsizeof=lambda v: v)
+
+        cache["a"] = 3
+        cache["b"] = 3          # currsize == 6
+        cache["b"] = 7          # grow "b"; final size would be a(3) + b(7) == 10 == maxsize
+
+        self.assertEqual(dict(cache), {"a": 3, "b": 7})
+        self.assertEqual(cache.currsize, 10)
+
